{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ViviBeri/webcraft-pro/blob/main/docs/schemas/skill-doctor-report.v1.json",
  "title": "WebCraft Pro Skill Doctor Report",
  "description": "Stable machine-readable diagnostics emitted by webcraft-skill-doctor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "summary",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "tool": {
      "const": "webcraft-skill-doctor"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesScanned",
        "diagnostics",
        "errors",
        "warnings",
        "info"
      ],
      "properties": {
        "filesScanned": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "severity",
          "file",
          "message",
          "relatedFiles",
          "fixHint"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^SKILL[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "relatedFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "fixHint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
