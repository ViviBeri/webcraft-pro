{
  "name": "webcraft-pro",
  "version": "1.6.0",
  "private": false,
  "description": "Framework-agnostic AI agent skills for website design, engineering and security.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "webcraft": "./scripts/install-skills.mjs"
  },
  "files": [
    "scripts/install-skills.mjs",
    "skills/",
    "stages/",
    "standards/",
    "README.md"
  ],
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "validate:skill-count": "node scripts/validate-skill-count.mjs",
    "validate:consistency": "node scripts/check-consistency.mjs",
    "validate:links": "node scripts/check-links.mjs",
    "test:links": "node --test scripts/check-links.test.mjs",
    "validate:stage-coverage": "node scripts/validate-stage-coverage.mjs",
    "test:stage-coverage": "node --test scripts/validate-stage-coverage.test.mjs",
    "validate:evals": "node evals/routing/validate-evals.mjs",
    "install:skills": "node scripts/install-skills.mjs",
    "test:installer": "node --test scripts/install-skills.test.mjs",
    "test:validate": "node --test scripts/validate-skills.test.mjs",
    "test:consistency": "node --test scripts/check-consistency.test.mjs",
    "test:security": "node --test scripts/security-audit.test.mjs",
    "test:accessibility": "node --test tests/accessibility/keyboard.test.mjs",
    "install:browsers": "playwright install --with-deps chromium",
    "browser:check": "node scripts/browser-checker.mjs",
    "validate:skill-doctor": "node scripts/skill-doctor.mjs --strict",
    "test:skill-doctor": "node --test scripts/skill-doctor.test.mjs",
    "validate:version-sync": "node scripts/check-version-sync.mjs",
    "test:version-sync": "node --test scripts/check-version-sync.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViviBeri/webcraft-pro.git"
  }
}
